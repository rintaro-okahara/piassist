.venv/
__pycache__/
*.py[cod]
.pytest_cache/
tmp/
output/
web/assets/*.whl
web/samples/*.pdf

# User-provided score files stay local by default. Add an explicit negation
# rule only for a deliberately publishable fixture.
*.[pP][dD][fF]
*_pages/

# Deliberately publishable test PDFs. Keep all other PDFs local.
!tests/fixtures/aura_lee_dorico/input.pdf
!tests/fixtures/purcell_what_power_dorico/input.pdf
!tests/fixtures/sibelius/aura_lee/input.pdf
